# Run commands from keyserver/. Copy to .env (ignored by Git).
BIND_ADDR=127.0.0.1:8080
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=ANT4AF24p1io1pmdNFKd9RKMStLCFi6WGbu81QoGzqN6
# Exact public origin, included in the wallet-signed challenge.
AUTH_ORIGIN=http://127.0.0.1:8080

# Dedicated Solana publication authority; never use the admin/wallet key.
# Must match Config.publication_authority on the configured network.
PUBLICATION_AUTHORITY_KEYPAIR=./secrets/publication-authority.json
# Optional fee payer of the daily reap crank (distinct from the authority, funded in SOL).
# Unset: the crank is disabled.
# CRANK_KEYPAIR=./secrets/crank.json
# Generate ONCE with: openssl rand -base64 32
# Preserve securely alongside backups; changing this value does not rotate the DB.
KEY_ENCRYPTION_KEY=
# PostgreSQL (CNPG: PGHOST=<cluster>-rw.<namespace>.svc).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=moment
PGUSER=moment
PGPASSWORD=
PGSSLMODE=verify-full
# CNPG CA Secret mounted as a file. Required for its private CA.
PGSSLROOTCERT=/absolute/path/to/ca.crt
DATABASE_MAX_CONNECTIONS=10
# Local devnet tests only: PGSSLMODE=disable and unset PGSSLROOTCERT.

# Private R2 bucket. Keep r2.dev and public custom domains disabled.
BLOB_STORE=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=moment-devnet
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# For a local devnet run: BLOB_STORE=local, BLOB_DIR=./data/blobs
BLOB_DIR=./data/blobs

MODERATION_MODEL_PATH=../app/app/src/main/assets/moderation/marqo-nsfw.onnx
MODERATION_POLICY_PATH=../app/app/src/main/assets/moderation/policy.json
# Absolute path to the ONNX Runtime 1.23.2 shared library.
ORT_DYLIB_PATH=/absolute/path/to/libonnxruntime.so
# Current policy is experimental. Explicit devnet-only opt-in; rejected on mainnet.
ALLOW_UNCALIBRATED_MODERATION=false

# Explicit ingress/proxy networks allowed to supply X-Forwarded-For. Empty for direct access.
TRUSTED_PROXY_CIDRS=
