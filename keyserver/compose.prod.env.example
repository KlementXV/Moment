# Copy to .env.prod, chmod 600, and pass with docker compose --env-file .env.prod.
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=ANT4AF24p1io1pmdNFKd9RKMStLCFi6WGbu81QoGzqN6
AUTH_ORIGIN=https://YOUR_BACKEND_HOST
KEY_ENCRYPTION_KEY=
# Optional: a separate funded keypair at secrets/crank.json enables pool settlement.
# CRANK_KEYPAIR=/var/run/moment-secrets/crank.json

PGDATABASE=moment
PGUSER=moment
PGPASSWORD=
DATABASE_MAX_CONNECTIONS=10

BLOB_STORE=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=moment-devnet
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

ALLOW_UNCALIBRATED_MODERATION=true
TRUSTED_PROXY_CIDRS=
MOMENT_BIND_PORT=8080
